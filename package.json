{
  "name": "machinedrum-webloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "catalog": "node scripts/catalog.ts",
    "dev": "npm run catalog && vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run catalog && npm run check && vite build && node scripts/package-site.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": { "typescript": "7.0.2", "vite": "8.3.8", "@types/node": "22.19.3" }
}
